# ============================================================
# CASH AI – Dateien und Ordner, die nicht auf GitHub gehören
# ============================================================

# Virtuelle Python-Umgebungen
.venv/
venv/
env/

# Python-Zwischen- und Cachedateien
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Vertrauliche bzw. echte Unternehmensdaten
# Der Ordner "Eingabedaten" mit anonymisierten Dummy-Daten bleibt erlaubt.
Eingabedaten_Echt/
Echtdaten/
Daten_Echt/
private_data/
real_data/

# Zugangsdaten und lokale Konfiguration
.env
.env.*
!.env.example
secrets.*
credentials.*

# Automatisch erzeugte CASH-AI-Ergebnisse
Ergebnisse_CASH_AI/

# Trainierte Modelle und Modell-Zwischendateien
Modelle_CASH_AI/
*.joblib
*.pkl

# Jupyter-Zwischendateien
.ipynb_checkpoints/

# VS-Code-Einstellungen
.vscode/

.matplotlib_cache/

# Temporäre Microsoft-Office-Dateien
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx

# Betriebssystemdateien
.DS_Store
Thumbs.db
desktop.ini

# Protokoll- und temporäre Dateien
*.log
*.tmp
*.temp

